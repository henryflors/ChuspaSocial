# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Variables de entorno
.env
.env.local
.env.*.local

# Logs
*.log
logs/
npm-debug.log*

# Dependencias
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo

# Build / compilación
dist/
build/
out/
target/
*.o
*.exe
*.dll
*.so

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Cobertura de tests
coverage/
.coverage
htmlcov/

# Moodle: evitar versionar datos locales y la caché de PHPUnit.
moodledata/
.phpunit.result.cache

# Datos sensibles
*.pem
*.key
*.cert
# Certificados X.509 (públicos o con cadena); pueden exponer la infraestructura y suelen ir junto a su clave privada
*.crt
# Contenedores PKCS#12: guardan el certificado Y la clave privada (a menudo con contraseña débil)
*.p12
# Igual que .p12 (formato PKCS#12 usado en Windows); nunca deben versionarse
*.pfx